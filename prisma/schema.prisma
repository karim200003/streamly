generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

/// The two kinds of title the app handles. Previously a bare `String`
/// on four tables, with the invariant enforced only in route handlers.
enum MediaType {
  movie
  tv
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role           @default(USER)
  banned        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  accounts      Account[]
  favorites     Favorite[]
  history       WatchHistory[]
  comments      Comment[]
  featured      Featured[]

  @@index([createdAt(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  id         String    @id @default(cuid())
  userId     String
  tmdbId     Int
  mediaType  MediaType
  title      String
  posterPath String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, createdAt(sort: Desc)])
}

model WatchHistory {
  id         String    @id @default(cuid())
  userId     String
  tmdbId     Int
  mediaType  MediaType
  title      String
  posterPath String?
  season     Int       @default(0)
  episode    Int       @default(0)
  progress   Float     @default(0)
  duration   Float     @default(0)
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType, season, episode])
  // Backs the "Continue watching" query (ORDER BY updatedAt DESC
  // WHERE userId = ?). With this composite + DESC sort, Postgres
  // serves top-N reads as an index range scan, no sort step.
  @@index([userId, updatedAt(sort: Desc)])
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  tmdbId    Int
  mediaType MediaType
  body      String
  rating    Int? // 1-10, optional
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  hidden    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tmdbId, mediaType, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// Admin-curated featured pick that overrides the homepage hero.
model Featured {
  id           String    @id @default(cuid())
  tmdbId       Int
  mediaType    MediaType
  title        String
  overview     String    @default("")
  posterPath   String?
  backdropPath String?
  voteAverage  Float     @default(0)
  releaseDate  String?
  active       Boolean   @default(true)
  position     Int       @default(0)
  createdById  String
  createdAt    DateTime  @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([tmdbId, mediaType])
  @@index([active, position])
}
